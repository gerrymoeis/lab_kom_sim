# =============================================================================
# SIMLABKOM — E2E Production Test — API Keys template
# Copy file ini ke keys.env lalu isi dengan nilai REAL dari
# poc_prototype/scripts/build_linux_release/.env.config
# JANGAN commit keys.env yang berisi nilai asli ke git.
#
# Script run_e2e.sh mewajibkan SEMUA key terisi (F0 cek).
# Semua key DIPAKAI PENUH (bukan cuma diisi):
#   GEMINI_API_KEY        -> OCR logbook (primary), versi lama & baru
#   OPENROUTER_API_KEY    -> OCR logbook (fallback), versi lama & baru
#   PC_PHOTO_RELEASE_URL  -> seed foto PC via GitHub release
#   PC_PHOTO_TOKEN        -> versi baru (refactoring) seed_pc_photos.go
#   GITHUB_TOKEN          -> versi lama (main) seed_pc_photos.go
# =============================================================================

GEMINI_API_KEY=
OPENROUTER_API_KEY=
PC_PHOTO_RELEASE_URL=https://github.com/gerrymoeis/asset_lab_kom_mi/releases/download/v2.0.0/photos.zip
PC_PHOTO_TOKEN=
GITHUB_TOKEN=